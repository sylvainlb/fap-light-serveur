# Caddy — TLS front end of the FAP-light server (spec §3)
# Local (FAP_DOMAIN=localhost): self-signed certificate (tls internal).
# Production: FAP_DOMAIN=<real domain> -> automatic Let's Encrypt certificates.
{
	auto_https off
}

{$FAP_DOMAIN:localhost} {
	tls internal
	reverse_proxy orce:1880
}

:80 {
	redir https://{$FAP_DOMAIN:localhost}{uri} permanent
}
