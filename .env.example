# ============================================================================
# FAP-light — environment variables (copy to .env and edit)
# ============================================================================

# --- PostgreSQL (roles admin/gate/reader/app, spec §C1.4) ---
PG_ADMIN_PASSWORD=change-me-admin
PG_GATE_PASSWORD=change-me-gate
PG_READER_PASSWORD=change-me-reader
PG_APP_PASSWORD=change-me-app
PG_PORT=5432

# --- ORCE (Node-RED) ---
ORCE_PORT=1880
# Shared HMAC secret of the DSP data plane (canonical form D-3, spec §9) — shared
# with consumers via the control plane, never in a query string.
DSP_HMAC_SECRET=change-me-hmac-secret
# Test/contract agreement (DSP control plane)
DSP_AGREEMENT_ID=agreement:tck:ca-s4
SIM_SITE_ID=site-berlin-001
SIM_SEED=fap-light

# --- SFTP (external source) ---
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=fap
SFTP_PASSWORD=change-me-sftp
SFTP_PUBLISHED_PORT=2222     # port published on the host for SFTP clients
SFTP_INGEST_DIR=/ingest
SFTP_ARCHIVE_DIR=/archive
SFTP_MAX_BYTES=1048576

# --- MQTT ---
MQTT_PORT=1883

# --- caddy (TLS front end) ---
FAP_DOMAIN=localhost        # set the real domain in production (automatic Let's Encrypt certificates)

# --- Keycloak (IdP, decision D-4) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# --- Pile IA (chantier 5, spec app-ai-component-editor.md) ---
# Active le service dédié : mettre "ai" dans COMPOSE_PROFILES (ex. COMPOSE_PROFILES=ai)
# COMPOSE_PROFILES=ai
LDP_BASE_URL=http://caddy           # serveur de données LDP (voie standard)
AI_MODELS_CONTAINER=/ai_models/     # registre de modèles (annexe B)
AI_JWT_VERIFY=0                     # dev : JWT décodé sans vérif de signature (réseau interne TLS)
AI_DEV_INSECURE=0                   # dev : accepte X-Webid/X-Role (tests)
AI_BUDGET_MAX_RUNS=0                # F6.3 : 0 = illimité ; sinon seuil par composant et par fenêtre
AI_BUDGET_WINDOW_DAYS=30
AI_JOB_RETENTION_DAYS=7             # purge des jobs (annexe C)
# Credentials des endpoints distants (F1.4) — jamais dans le registre LDP :
# AI_MODEL_SECRET_REMOTE_API_MISTRAL=sk-...
# F6.2 (arbitré J15, rev 6) : token exchange RFC 8693 par défaut en production
AI_TOKEN_EXCHANGE=0                     # 1 = échange de jeton contre l'identité du demandeur
# IDP_TOKEN_URL=https://<pod>/realms/fap/protocol/openid-connect/token
# AI_CLIENT_ID=ai-stack
# AI_CLIENT_SECRET=change-me-client-secret
# SHACL_VALIDATE_URL_TEMPLATE=         # surcharge optionnelle de l'URL de validation J3
