# ============================================================================
# FAP-light — environment variables (copy to .env and edit)
# ============================================================================

# --- PostgreSQL (roles admin/gate/reader/app, spec §C1.4) ---
PG_ADMIN_PASSWORD=change-me-admin
PG_GATE_PASSWORD=change-me-gate
PG_READER_PASSWORD=change-me-reader
PG_APP_PASSWORD=change-me-app
PG_PORT=5432

# --- ORCE (Node-RED) ---
ORCE_PORT=1880
# Shared HMAC secret of the DSP data plane (canonical form D-3, spec §9) — shared
# with consumers via the control plane, never in a query string.
DSP_HMAC_SECRET=change-me-hmac-secret
# Test/contract agreement (DSP control plane)
DSP_AGREEMENT_ID=agreement:tck:ca-s4
SIM_SITE_ID=site-berlin-001
SIM_SEED=fap-light

# --- SFTP (external source) ---
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=fap
SFTP_PASSWORD=change-me-sftp
SFTP_PUBLISHED_PORT=2222     # port published on the host for SFTP clients
SFTP_INGEST_DIR=/ingest
SFTP_ARCHIVE_DIR=/archive
SFTP_MAX_BYTES=1048576

# --- MQTT ---
MQTT_PORT=1883

# --- caddy (TLS front end) ---
FAP_DOMAIN=localhost        # set the real domain in production (automatic Let's Encrypt certificates)

# --- Keycloak (IdP, decision D-4) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
