# ============================================================================
# FAP-light — variables d'environnement (copier en .env et éditer)
# ============================================================================

# --- PostgreSQL (rôles admin/gate/reader/app, spec §C1.4) ---
PG_ADMIN_PASSWORD=change-me-admin
PG_GATE_PASSWORD=change-me-gate
PG_READER_PASSWORD=change-me-reader
PG_APP_PASSWORD=change-me-app
PG_PORT=5432

# --- ORCE (Node-RED) ---
ORCE_PORT=1880
# Secret HMAC partagé du data plane DSP (forme canonique D-3, spec §9) — partage
# avec les consommateurs via le plan de contrôle, jamais en query string.
DSP_HMAC_SECRET=change-me-hmac-secret
# Agreement de test/contrat (plan de contrôle DSP)
DSP_AGREEMENT_ID=agreement:tck:ca-s4
SIM_SITE_ID=site-berlin-001
SIM_SEED=fap-light

# --- SFTP (source externe) ---
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=fap
SFTP_PASSWORD=change-me-sftp
SFTP_PUBLISHED_PORT=2222     # port publié sur l'hôte pour les clients SFTP
SFTP_INGEST_DIR=/ingest
SFTP_ARCHIVE_DIR=/archive
SFTP_MAX_BYTES=1048576

# --- MQTT ---
MQTT_PORT=1883

# --- caddy (TLS frontal) ---
FAP_DOMAIN=localhost        # mettre le vrai domaine en production (certificats Let's Encrypt auto)

# --- Keycloak (IdP, décision D-4) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
